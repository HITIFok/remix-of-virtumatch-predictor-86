# =============================================
# Variables d'environnement - VirtuMatch
# =============================================
# Ce fichier est un EXEMPLE. Ne JAMAIS stocker de vraies valeurs ici.
# Pour le développement local, copiez ce fichier en .env.local

# --- Supabase (frontend) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- API Scraper (Edge Functions & Vercel API) ---
# (Configurer dans Supabase Dashboard > Edge Functions > Secrets)
# et dans Vercel Dashboard > Settings > Environment Variables
# SPORTY_API_BASE=your-sporty-api-base-url
# API_ORIGIN=your-api-origin
# API_REFERER=your-api-referer
# API_APP_VERSION=your-api-app-version

# --- Python Scrapers (à exporter dans le terminal) ---
# export SUPABASE_URL='https://your-project.supabase.co'
# export PUSH_KEY='your-push-key'
# export ANON_KEY='your-anon-key-here'
# export SPORTY_API_BASE='your-sporty-api-base-url'
# export API_ORIGIN='your-api-origin'
# export API_REFERER='your-api-referer'
# export API_APP_VERSION='your-api-app-version'
# export SCRAPER_TARGET_URL='your-target-url'   # Pour scraper-termux.py / scraper-local.py

# --- Supabase Edge Functions Secrets ---
# (Configurer dans Supabase Dashboard > Edge Functions > Secrets)
# CRON_SECRET=your-cron-secret
# SCRAPER_PUSH_KEY=your-scraper-push-key
# ALLOWED_ORIGIN=https://virtual-match-hitifproject.vercel.app
# LOVABLE_API_KEY=your-lovable-api-key

# --- GitHub Secrets (pour le workflow build-apk.yml) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# KEYSTORE_BASE64=<base64-encoded-keystore>
# KEYSTORE_PASSWORD=your-keystore-password
