# Variables d'environnement Supabase
# Ces valeurs doivent être configurées dans les GitHub Secrets pour le build CI
# Pour le développement local, créez un fichier .env.local avec les vraies valeurs

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Variables pour les scripts Python (scraper)
# Les clés ne doivent JAMAIS être commitées dans le dépôt
# Exportez-les dans votre terminal avant d'exécuter les scripts :
#   export PUSH_KEY='votre_cle_push'
#   export ANON_KEY='votre_cle_anon'
