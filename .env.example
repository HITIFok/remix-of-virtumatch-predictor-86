# =============================================
# Variables d'environnement - VirtuMatch
# =============================================
# Ce fichier est un EXEMPLE. Ne JAMAIS stocker de vraies valeurs ici.
# Pour le developpement local, copiez ce fichier en .env.local

# --- Frontend (exposées au client via Vite) ---
# VITE_API_BASE=https://virtual-match-hitifproject.vercel.app
# VITE_APK_DOWNLOAD_URL=https://your-hosting.com/app-release.apk

# --- Vercel Environment Variables (serveur uniquement, jamais exposées au client) ---
# NEON_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# ADMIN_TOKEN_SECRET=your-random-secret-min-32-chars
# SCRAPER_PUSH_KEY=your-scraper-push-key
# SPORTY_API_BASE=your-sporty-api-base-url
# API_ORIGIN=your-api-origin
# API_REFERER=your-api-referer
# API_APP_VERSION=your-api-app-version

# --- Python Scrapers (a exporter dans le terminal avant exécution) ---
# export PUSH_URL=https://your-app.vercel.app/api/push-odds
# export PUSH_KEY=your-scraper-push-key
# export SPORTY_API_BASE=your-sporty-api-base-url
# export API_ORIGIN=your-api-origin
# export API_REFERER=your-api-referer
# export API_APP_VERSION=your-api-app-version

# --- GitHub Secrets (pour le workflow build-apk.yml) ---
# VITE_API_BASE=https://virtual-match-hitifproject.vercel.app
# KEYSTORE_BASE64=<base64-encoded-keystore>
# KEYSTORE_PASSWORD=your-keystore-password
