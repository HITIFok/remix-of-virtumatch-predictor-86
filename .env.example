# =============================================
# Variables d'environnement - VirtuTel Bet261
# =============================================
# Ce fichier est un EXEMPLE. Ne JAMAIS stocker de vraies valeurs ici.
# Pour le développement local, copiez ce fichier en .env.local

# --- Supabase (frontend) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Python Scrapers (à exporter dans le terminal) ---
# export SUPABASE_URL='https://your-project.supabase.co'
# export PUSH_KEY='your-push-key'
# export ANON_KEY='your-anon-key-here'

# --- Supabase Edge Functions Secrets ---
# (Configurer dans Supabase Dashboard > Edge Functions > Secrets)
# CRON_SECRET=your-cron-secret
# SCRAPER_PUSH_KEY=your-scraper-push-key
# ALLOWED_ORIGIN=https://virutel-bet261.vercel.app

# --- GitHub Secrets (pour le workflow build-apk.yml) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# KEYSTORE_BASE64=<base64-encoded-keystore>
# KEYSTORE_PASSWORD=your-keystore-password
